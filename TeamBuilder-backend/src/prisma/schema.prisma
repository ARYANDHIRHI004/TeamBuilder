// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum STATUS {
  ACTIVE
  INACTIVE
}

enum TeamApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Teamroles {
  TEAM_LEAD
  MEMBER
}

enum UserRole {
  ADMIN
  SUPERADMIN
  STUDENT
}


model User {
  id                String   @id @default(uuid())
  name              String
  email             String   @unique
  address           String?
  roles             SystemRoles[]

  isEmailVerified   Boolean  @default(false)
  accountStatus     STATUS   @default(ACTIVE)

  sessions          Session[]
  teamMemberships   TeamMember[]
  applications      TeamJoiningApplication[]

  reviewsGiven      Review[] @relation("ReviewsGiven")
  reviewsReceived   Review[] @relation("ReviewsReceived")


  histories         History[] @relation("UserHistory")
  coursesCreaed Course[]

  messagesSent      DirectMessage[] @relation("MessagesSent")
  messagesReceived  DirectMessage[] @relation("MessagesReceived")
  teamChatMessages  TeamChatMessage[] @relation("TeamChatSent")

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model SystemRoles {
  id String @id @default(uuid())
  userId String
  role UserRole

  roleOf      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

}

model Course {
  id                String   @id @default(uuid())
  courseName        String
  courseDescription String?
  createdBy String
  creater User @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  teams             Team[]
  registeredUsers   RegisteredUser[]
  directMessages    DirectMessage[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}



model Team {
  id                String   @id @default(uuid())
  teamName          String   @unique
  teamDescription   String?

  courseId          String
  course            Course   @relation(fields: [courseId], references: [id])

  status            STATUS   @default(ACTIVE)
  hiring            STATUS @default(INACTIVE)
  approvalStatus    TeamApprovalStatus @default(PENDING)

  members           TeamMember[]
  applications      TeamJoiningApplication[]
  notes             Note[]

  reviewsReceived   Review[] @relation("TeamReviews")

  chatMessages      TeamChatMessage[]

  histories         History[] @relation("TeamHistory")

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model TeamMember {
  id          String         @id @default(uuid())

  memberId    String
  member      User           @relation(fields: [memberId], references: [id], onDelete: Cascade)

  teamId      String
  team        Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)

  role        Teamroles @default(MEMBER)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([memberId, teamId])
}

model TeamJoiningApplication {
  id          String   @id @default(uuid())

  userId      String
  user        User     @relation(fields: [userId], references: [id])

  teamId      String
  team        Team     @relation(fields: [teamId], references: [id])

  description String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Note {
  id          String   @id @default(uuid())

  teamId      String
  team        Team     @relation(fields: [teamId], references: [id])

  note        String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Review {
  id          String   @id @default(uuid())

  review      String

  givenById   String
  givenBy     User     @relation("ReviewsGiven", fields: [givenById], references: [id])

  // Review can be given to either a User or a Team
  givenToUserId String?
  givenToUser   User?   @relation("ReviewsReceived", fields: [givenToUserId], references: [id])

  givenToTeamId String?
  givenToTeam   Team?   @relation("TeamReviews", fields: [givenToTeamId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RegisteredUser {
  id          String   @id @default(uuid())

  courseId    String
  course      Course   @relation(fields: [courseId], references: [id])

  userEmail   String


  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([courseId, userEmail])
}

model Session {
  id            String   @id @default(uuid())

  refreshToken  String
  sessions      Int

  userId        String
  user          User     @relation(fields: [userId], references: [id])

  systemIP      String?
  device        String?
  browser       String?

  latitude      Float?
  longitude     Float?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Subscription {
  id          String   @id @default(uuid())
  description String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model History {
  id          String   @id @default(uuid())

  description String

  // Either User or Team history
  userId      String?
  user        User?    @relation("UserHistory", fields: [userId], references: [id])

  teamId      String?
  team        Team?    @relation("TeamHistory", fields: [teamId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DirectMessage {
  id          String   @id @default(uuid())

  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  senderId    String
  sender      User     @relation("MessagesSent", fields: [senderId], references: [id], onDelete: Cascade)

  receiverId  String
  receiver    User     @relation("MessagesReceived", fields: [receiverId], references: [id], onDelete: Cascade)

  content     String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([courseId, senderId, receiverId])
}

model TeamChatMessage {
  id           String   @id @default(uuid())

  teamId       String
  team         Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  senderId     String
  sender       User     @relation("TeamChatSent", fields: [senderId], references: [id], onDelete: Cascade)

  content      String?
  resourceUrl  String?
  resourceName String?
  resourceMime String?

  isPinned     Boolean  @default(false)
  pinnedAt     DateTime?

  isDeleted    Boolean  @default(false)
  deletedAt    DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([teamId, createdAt])
}